ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://classswap:classswap@localhost:5432/classswap
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=__Host-classswap_session
COOKIE_SECURE=true
APP_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=
FORWARDED_ALLOW_IPS=127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=ClassSwap <no-reply@classswap.local>
TOTP_ENCRYPTION_KEY=
MAX_PERIOD=7
BREAK_AFTER=2,4
SUBJECT_MATCH_WEIGHT=0.35
ADJACENT_FREE_WEIGHT=0.25
FAIRNESS_WEIGHT=0.20
SAME_SEMESTER_WEIGHT=0.12
SAME_DEPARTMENT_WEIGHT=0.08
POSTGRES_USER=classswap
POSTGRES_PASSWORD=classswap
POSTGRES_DB=classswap
